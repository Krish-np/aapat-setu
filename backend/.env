# ===== Aapat Setu — Backend Environment =====
# Copy or edit this file to match your XAMPP MySQL credentials.
# Default XAMPP MySQL: user=root, password=empty, port=3306, db=aapatsetudb
# ⚠️ If your MySQL root has a password, put it between : and @ (e.g. root:MYPASS@localhost)

DATABASE_URL=mysql+pymysql://root:@localhost:3306/aapatsetudb?charset=utf8mb4

# ===== JWT Auth settings =====
# Replace this with your own long random string (run: python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=aapatsetudb-jwt-secret-change-this-to-your-own-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== SMTP / Email alerts (optional) =====
# Fill these to receive email notifications for critical incidents.
# For Gmail use an App Password: https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=Aapat Setu <no-reply@aapatsetu.app>
# SMTP_TLS=true
# ALERT_EMAIL_TO=ops@yourdomain.com,dispatch@yourdomain.com
