# Copy this file to .env (or just set env vars) to use XAMPP MySQL instead of SQLite
#
# Prerequisites:
#   1. Start XAMPP → turn on Apache + MySQL
#   2. Open http://localhost/phpmyadmin → create database `aapatsetudb` (utf8mb4)
#   3. Install the MySQL driver:  pip install pymysql cryptography
#
# Default XAMPP MySQL credentials: user=root, password=(empty), port=3306
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/aapatsetudb?charset=utf8mb4
